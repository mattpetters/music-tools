#!/bin/bash

# Reset an installed Ableton version's prefs and templates.
#
# Usage: reset_ableton <version>
#
# Backs up the preferences and templates to ~/Desktop/, then deletes
# the live copies. This is the only bash change in the mtui project —
# it was made interactive to be driveable from a non-tty parent.

set -euo pipefail

VERSION="${1:-}"
if [[ -z "$VERSION" ]]; then
    echo "usage: $0 <version>" >&2
    exit 2
fi

PREFS="$HOME/Library/Preferences/Ableton/$VERSION"
if [[ ! -d "$PREFS" ]]; then
    echo "no such version directory: $PREFS" >&2
    exit 1
fi
if [[ ! -f "$PREFS/Preferences.cfg" ]]; then
    echo "no Preferences.cfg for version $VERSION in $PREFS" >&2
    exit 1
fi

# Back up the prefs file.
cp "$PREFS/Preferences.cfg" "$HOME/Desktop/Preferences.backup.cfg"

# Remove the live prefs and the Undo folder.
rm "$PREFS/Preferences.cfg"
rm -rf "$PREFS/Undo"

# Back up and remove the Templates folder, if it exists.
TEMPLATES="$HOME/Music/Ableton/User Library/Templates"
if [[ -d "$TEMPLATES" ]]; then
    cp -r "$TEMPLATES" "$HOME/Desktop/Templates Backups"
    rm -rf "$TEMPLATES"
fi

echo "Reset Ableton $VERSION."
echo "  Backups at: ~/Desktop/Preferences.backup.cfg, ~/Desktop/Templates Backups/"
